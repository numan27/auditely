# ── Admin login (required) ────────────────────────────────────────────────────
# The whole app is behind a single shared password.
ADMIN_PASSWORD=your_admin_password_here
# 32+ random characters, used to sign the session cookie: `openssl rand -hex 32`
AUTH_SECRET=your_auth_secret_here

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=your_supabase_url_here
# Server-only key (Dashboard → Project Settings → API → service_role). Required
# once Row Level Security is enabled (docs/migrations/2026-09-23-hardening.sql).
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Legacy fallback, only works while RLS is disabled
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Business search & city autocomplete ──────────────────────────────────────
# Both use Google Places (New). The free Geoapify provider is commented out in
# lib/places/searchPlaces.ts and api/autocomplete/route.ts; while it is,
# PLACES_PROVIDER and GEOAPIFY_API_KEY are ignored.
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
# Only needed if Geoapify is switched back on (free plan, 3,000 credits/day,
# no card: https://myprojects.geoapify.com)
PLACES_PROVIDER=geoapify
GEOAPIFY_API_KEY=your_geoapify_api_key_here

# ── PDF report "next step" box (all optional) ────────────────────────────────
# Shown to the prospect at the end of the report. Unset values are left out.
# "Book your free call" opens REPORT_BOOKING_URL (e.g. your Calendly link,
# https://calendly.com/your-name/30min), or emails REPORT_CONTACT_EMAIL when
# unset. A "Contact us" email button is added next to it when the link is set.
REPORT_CONTACT_NAME=
REPORT_CONTACT_PHONE=
REPORT_CONTACT_EMAIL=contact@devartventures.com
REPORT_BOOKING_URL=

GOOGLE_PAGESPEED_API_KEY=your_google_pagespeed_api_key_here

GROQ_API_KEY=your_groq_api_key_here

# ── Email finder cascade (tried in order, all optional) ──────────────────────
# Scraping runs first (free). If no email found, these APIs are called in
# sequence — first hit wins. Add as many or as few as you want.

# Snov.io — 50 free credits/month (most generous). Requires OAuth client.
# https://app.snov.io/account/api  →  "Create API user"
SNOV_CLIENT_ID=your_snov_client_id_here
SNOV_CLIENT_SECRET=your_snov_client_secret_here

# Tomba.io — 25 free searches/month. https://app.tomba.io/api
TOMBA_API_KEY=your_tomba_api_key_here
TOMBA_SECRET=your_tomba_secret_here

# Hunter.io — 25 free searches/month. https://hunter.io/api-keys
HUNTER_API_KEY=your_hunter_api_key_here

# Apollo.io — 50 free credits/month. Free tier sometimes returns masked emails.
# https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# ── Email sending (optional, not currently used by UI) ───────────────────────
RESEND_API_KEY=your_resend_api_key_here
FROM_EMAIL=you@yourdomain.com

# ── HubSpot ("Send to HubSpot" button) ───────────────────────────────────────
# A HubSpot service key: Development → Keys → Service keys → Create service key,
# with crm.objects.companies.read/write and crm.objects.contacts.read/write.
# Server-only; never commit the real key.
HUBSPOT_TOKEN=
